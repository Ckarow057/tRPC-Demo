{
  "name": "backend",
  "version": "1.0.0",
  "description": "tRPC Demo Backend - Fastify + PostgreSQL + Drizzle ORM",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
